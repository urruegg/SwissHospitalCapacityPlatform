{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swisshospitalcapacity/csa/response-levers.schema.json",
  "title": "CSA response-lever document",
  "description": "Sprint 16 T3 — schema for the Cosmos `response-levers` container (PK /leverId).",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "leverId",
    "name",
    "category",
    "doctrineTier",
    "description",
    "appliesToResources",
    "advisoryOnly"
  ],
  "properties": {
    "leverId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "name": { "type": "string", "minLength": 3 },
    "category": {
      "type": "string",
      "enum": [
        "surge-capacity",
        "staffing",
        "patient-flow",
        "supply-chain",
        "coordination",
        "communication",
        "continuity"
      ]
    },
    "doctrineTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "description": { "type": "string", "minLength": 3 },
    "appliesToResources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "advisoryOnly": {
      "type": "boolean",
      "const": true
    },
    "doctrineRef": { "type": "string" },
    "descriptionEmbedding": {
      "type": "array",
      "items": { "type": "number" }
    }
  }
}
