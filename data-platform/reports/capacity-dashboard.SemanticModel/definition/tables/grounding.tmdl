				{ "FR-OM-014", "ADR-0015", "hcp:ORSchedule", "Idle-Slot Minutes", "page-or-coordinator / KPI wall" },
				{ "FR-DATA-001", "ADR-0015", "hcp:CapacityBaseline", "Narrative — Bed Manager", "page-bed-manager / smart narrative" },
				{ "FR-DATA-002", "ADR-0015", "hcp:CapacityBaseline", "Narrative — Ops Lead", "page-ops-lead / smart narrative" },
				{ "FR-DATA-003", "ADR-0015", "hcp:ORCase", "Narrative — OR Coordinator", "page-or-coordinator / smart narrative" },
				{ "NFR-COMP-001", "ADR-0008", "hcp:Persona", "Effective Viewing Label", "all pages / RLS-proof pill" },
