/// M6 grounding table (design spec §7, plan Task 6.1). Import-mode calculated table
/// mirroring data-platform/reports/capacity-dashboard.Report/grounding.yaml so the
/// page-grounding matrix renders bound content (requirement -> ADR -> ontology entity
/// -> measure -> visual location). Keep in sync with the YAML source of truth.
table grounding
	lineageTag: 8ee1e870-a40c-4d3a-abeb-38f3f5b4ffb4

	column Requirement
		dataType: string
		lineageTag: 0e4ddde8-5f4a-436b-b404-e3541e68c9c0
		summarizeBy: none
		sourceColumn: [Value1]

		annotation SummarizationSetBy = Automatic

	column ADR
		dataType: string
		lineageTag: ded9ce05-40e6-4ef0-bc31-00017de33bbc
		summarizeBy: none
		sourceColumn: [Value2]

		annotation SummarizationSetBy = Automatic

	column Entity
		dataType: string
		lineageTag: 3a34012b-8708-4f02-8e54-8c6f9b2c5ceb
		summarizeBy: none
		sourceColumn: [Value3]

		annotation SummarizationSetBy = Automatic

	column Measure
		dataType: string
		lineageTag: 53f01c46-ac20-4405-963a-c1fb8ff350b1
		summarizeBy: none
		sourceColumn: [Value4]

		annotation SummarizationSetBy = Automatic

	column Location
		dataType: string
		lineageTag: bd65eb6d-f71a-4a2a-9a88-c24fe6f52378
		summarizeBy: none
		sourceColumn: [Value5]

		annotation SummarizationSetBy = Automatic

	partition grounding = calculated
		mode: import
		source = ```
				DATATABLE(
				    "Value1", STRING, "Value2", STRING, "Value3", STRING, "Value4", STRING, "Value5", STRING,
				    {
