				{ "FR-OM-003", "ADR-0015", "hcp:WardCapacityUnit", "Beds Total", "page-bed-manager / capacity chart" },
				{ "FR-OM-004", "ADR-0002", "hcp:Encounter", "Currently In Hospital", "page-ops-lead / headline KPIs" },
				{ "FR-OM-005", "ADR-0002", "hcp:Encounter", "Admissions", "page-ops-lead / flow cards" },
				{ "FR-OM-006", "ADR-0002", "hcp:Encounter", "Discharged", "drill-discharge / status matrix" },
				{ "FR-OM-010", "ADR-0015", "hcp:ORCase", "OR Utilization %", "page-or-coordinator / KPI wall" },
				{ "FR-OM-011", "ADR-0015", "hcp:ORCase", "First-Case On-Time %", "page-or-coordinator / KPI wall" },
				{ "FR-OM-012", "ADR-0015", "hcp:ORCase", "Short-Notice Cancellation %", "page-or-coordinator / donut" },
