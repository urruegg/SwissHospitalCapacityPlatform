table bed_assignment
	lineageTag: 5a2c9b31-2f6d-4a3d-a0e2-b5d40b3c8ef2
	sourceLineageTag: [gold].[bed_assignment]

	measure 'Currently Assigned Beds' = DISTINCTCOUNT(bed_assignment[eventId])
		formatString: #,0
		lineageTag: 9e1bb4d1-d41c-4e75-c4f2-3d2d5b4e0f12

		changedProperty = Name

		changedProperty = FormatString

	measure 'Occupancy %' = DIVIDE([Currently Assigned Beds], [Beds Total]) * 100
		formatString: 0.0"%"
		lineageTag: 9e1bb4d1-d41c-4e75-c4f2-3d2d5b4e0f30

		changedProperty = Name

		changedProperty = FormatString

	/// M5 synthetic proxy (design spec §6.2 field-parameter member). Free beds = capacity minus
	/// currently-assigned. Non-negative floor guards synthetic over-assignment edge cases.
	measure 'Beds Free' = MAX(0, [Beds Total] - [Currently Assigned Beds])
		formatString: #,0
		lineageTag: 262f99e2-7b8e-4a32-920b-fcf15a9f1ace

		changedProperty = Name

		changedProperty = FormatString

	/// M5 synthetic proxy: no forecast pipeline exists yet (Sprint 10 ML lane owns it).
	/// Stands in with a deterministic +8% headroom over current assignment so the
	/// field-parameter swap and Ops Lead tiles render. Replace with the real 72-h
	/// forecast measure once the forecasting Gold table lands.
	measure 'Forecast Peak 72h' = ROUND([Currently Assigned Beds] * 1.08, 0)
		formatString: #,0
		lineageTag: 3c10f894-db87-4c5f-8652-b01088561c2b

		changedProperty = Name

		changedProperty = FormatString

	/// M5 synthetic proxy: variance of current assignment against the synthetic 72-h peak.
	measure 'Actual vs Forecast' = [Currently Assigned Beds] - [Forecast Peak 72h]
		formatString: +#,0;-#,0;0
		lineageTag: 8393c20a-17c9-4203-b9e2-cb3f0693281a

		changedProperty = Name

		changedProperty = FormatString

