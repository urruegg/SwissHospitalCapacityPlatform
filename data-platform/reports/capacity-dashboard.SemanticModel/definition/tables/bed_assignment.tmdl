	measure 'Currently Assigned Beds' = DISTINCTCOUNT(bed_assignment[eventId])
		formatString: #,0
		lineageTag: 9e1bb4d1-d41c-4e75-c4f2-3d2d5b4e0f12

		changedProperty = Name

		changedProperty = FormatString

	measure 'Occupancy %' = DIVIDE([Currently Assigned Beds], [Beds Total]) * 100
		formatString: 0.0"%"
		lineageTag: 9e1bb4d1-d41c-4e75-c4f2-3d2d5b4e0f30

		changedProperty = Name

		changedProperty = FormatString

