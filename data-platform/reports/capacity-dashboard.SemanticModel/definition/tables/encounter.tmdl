table encounter
	lineageTag: 4e1b8a20-1e5c-4e2c-9df1-a4c39a2b7de1
	sourceLineageTag: [gold].[encounter]

	measure 'Active Encounters' = DISTINCTCOUNT(encounter[eventId])
		formatString: #,0
		lineageTag: 8f0aa3d0-c30b-4d64-b3e1-2c1c4a3d9e01

		changedProperty = Name

		changedProperty = FormatString

	measure 'Admissions' = CALCULATE(COUNTROWS(encounter), encounter[status] = "arrived")
		formatString: #,0
		lineageTag: 8f0aa3d0-c30b-4d64-b3e1-2c1c4a3d9e30

		changedProperty = Name

		changedProperty = FormatString

	measure 'Discharged' = CALCULATE(COUNTROWS(encounter), encounter[status] = "finished")
		formatString: #,0
		lineageTag: 8f0aa3d0-c30b-4d64-b3e1-2c1c4a3d9e31

		changedProperty = Name

		changedProperty = FormatString

	measure 'Currently In Hospital' = CALCULATE(COUNTROWS(encounter), encounter[status] IN {"arrived", "triaged", "in-progress", "onleave"})
		formatString: #,0
		lineageTag: 8f0aa3d0-c30b-4d64-b3e1-2c1c4a3d9e32

		changedProperty = Name

		changedProperty = FormatString

