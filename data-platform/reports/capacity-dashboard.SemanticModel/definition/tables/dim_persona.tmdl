/// Persona directory for the RLS-proof pill and persona-anchored navigation.
/// Import-mode table — one of two intentional Import exceptions in an otherwise
/// Direct Lake model. Seeded from data/synthetic/personas.csv; Sprint 12 swaps
/// the source to a Fabric mirror of Entra ID (see design spec §6.1). The CSV is
/// the *temporary* source and must not be treated as a governed Sprint 6 dataset.
table dim_persona
	lineageTag: eb7098de-0ec6-494f-a906-db40e3f23eda

	measure 'Effective Identity UPN' = USERPRINCIPALNAME()
		lineageTag: b6d4e7f2-a440-440d-b155-076675069f31

		changedProperty = Name

	measure 'Effective Role Label' =
			LOOKUPVALUE(
			    dim_persona[app_role],
			    dim_persona[upn], [Effective Identity UPN]
			)
		lineageTag: ea2dc7f8-2268-489d-8ad6-e7767900ccde

		changedProperty = Name

	measure 'Effective Hospital' =
			VAR persona_hospital =
			    LOOKUPVALUE(
			        dim_persona[default_hospital],
			        dim_persona[upn], [Effective Identity UPN]
			    )
			VAR selected_hospital = SELECTEDVALUE(dim_hospital[short_name], persona_hospital)
			VAR is_demo = [Effective Role Label] IN { "HCC.DemoOperator", "HCC.SuperAdmin" }
			RETURN
			    IF(is_demo, selected_hospital, persona_hospital)
		lineageTag: eca5bb08-0902-4d92-b427-15ad104a7cae

		changedProperty = Name

	measure 'Effective Viewing Label' =
			VAR base = "Viewing: " & [Effective Hospital] & " • " & [Effective Role Label]
			VAR is_demo = [Effective Role Label] IN { "HCC.DemoOperator", "HCC.SuperAdmin" }
			RETURN
			    IF(is_demo, base & " (SIT demo override)", base)
		lineageTag: 6cde12e1-b057-4525-adc5-2588386637b5

		changedProperty = Name

	column upn
		dataType: string
		lineageTag: 51c6c3ec-7046-404b-88dd-2ea4abbfbf3a
		summarizeBy: none
		sourceColumn: upn

		annotation SummarizationSetBy = Automatic

	column display_name
		dataType: string
		lineageTag: 886438b3-0b50-40d5-a741-046b9b4a76e8
		summarizeBy: none
		sourceColumn: display_name

		annotation SummarizationSetBy = Automatic

	column app_role
		dataType: string
		lineageTag: dd7ce73e-7e7f-4c00-a493-5321cd6ecb18
		summarizeBy: none
		sourceColumn: app_role

		annotation SummarizationSetBy = Automatic

	column default_hospital
		dataType: string
		lineageTag: cb27ca52-4d26-4b1c-933c-62bdd77f0f3c
		summarizeBy: none
		sourceColumn: default_hospital

		annotation SummarizationSetBy = Automatic

	partition dim_persona = m
		mode: import
		source =
				// #552 fix: persona rows inlined from data/synthetic/personas.csv to
				// remove the unresolvable local File.Contents path that failed refresh in
				// Fabric (DMTS_MonikerWithUnboundDataSources) and blocked Direct Lake
				// framing of the whole model. Sprint 12 still swaps this to a Fabric
				// mirror of Entra ID (design spec §6.1).
				let
				    Source = #table(
				        type table [upn = text, display_name = text, app_role = text, default_hospital = text],
				        {
						{"dr.andrea.keller@mngenvmcap164444.onmicrosoft.com", "Dr. Andrea Keller", "HCC.OperationsLead", "USZ"},
						{"markus.frei@mngenvmcap164444.onmicrosoft.com", "Markus Frei", "HCC.BedManager", "USZ"},
						{"sandra.huber@mngenvmcap164444.onmicrosoft.com", "Sandra Huber", "HCC.FlowManager", "USZ"},
						{"thomas.brunner@mngenvmcap164444.onmicrosoft.com", "Dr. Thomas Brunner", "HCC.EDLead", "USZ"},
						{"nicole.baumann@mngenvmcap164444.onmicrosoft.com", "Nicole Baumann", "HCC.ORCoordinator", "USZ"},
						{"peter.schmid@mngenvmcap164444.onmicrosoft.com", "Peter Schmid", "HCC.StaffingCoordinator", "USZ"},
						{"claudia.steiner@mngenvmcap164444.onmicrosoft.com", "Claudia Steiner", "HCC.DischargeCoordinator", "USZ"},
						{"michael.weber@mngenvmcap164444.onmicrosoft.com", "Dr. Michael Weber", "HCC.CrisisManager", "USZ"},
						{"regula.bucher@mngenvmcap164444.onmicrosoft.com", "Dr. Regula Bucher", "HCC.OperationsLead", "LUKS"},
						{"stefan.zuend@mngenvmcap164444.onmicrosoft.com", "Stefan Zünd", "HCC.BedManager", "LUKS"},
						{"martina.achermann@mngenvmcap164444.onmicrosoft.com", "Martina Achermann", "HCC.DischargeCoordinator", "LUKS"},
						{"daniel.kaufmann@mngenvmcap164444.onmicrosoft.com", "Daniel Kaufmann", "HCC.ORCoordinator", "LUKS"},
						{"barbara.widmer@mngenvmcap164444.onmicrosoft.com", "Barbara Widmer", "HCC.OperationsLead", "Zollikerberg"},
						{"lukas.frei@mngenvmcap164444.onmicrosoft.com", "Lukas Frei", "HCC.FlowManager", "Zollikerberg"},
						{"christoph.vogt@mngenvmcap164444.onmicrosoft.com", "Dr. Christoph Vogt", "HCC.Executive", "Aggregated"},
						{"isabelle.girard@mngenvmcap164444.onmicrosoft.com", "Dr. Isabelle Girard", "HCC.CantonalViewer", "Aggregated"},
						{"urs.ruegg@mngenvmcap164444.onmicrosoft.com", "Urs Rüegg", "HCC.PlatformAdmin", "All"},
						{"elena.fischer@mngenvmcap164444.onmicrosoft.com", "Elena Fischer", "HCC.OntologySteward", "All"},
						{"rafael.moser@mngenvmcap164444.onmicrosoft.com", "Rafael Moser", "HCC.AIGovernance", "All"},
						{"sophie.meier@mngenvmcap164444.onmicrosoft.com", "Sophie Meier", "HCC.DemoOperator", "All"},
						{"hans.meier@mngenvmcap164444.onmicrosoft.com", "Hans Meier", "HCC.Auditor", "All"},
						{"super.admin@mngenvmcap164444.onmicrosoft.com", "Super Admin", "HCC.SuperAdmin", "All"},
						{"demo.guest@mngenvmcap164444.onmicrosoft.com", "Demo Guest", "HCC.GuestReadOnly", "Aggregated"}
				        }
				    )
				in
				    Source

	annotation PBI_ResultType = Table
