/// Trusted External Signals trigger audit fact (Sprint 21 M5). One row per
/// trigger evaluation or fire, materialised to gold.ext_fact_trigger_event.
/// Direct Lake over lh_ihzhhpf_sit.
table ext_fact_trigger_event
	lineageTag: 02b814ee-1c00-4128-8015-bd386a363d85
	sourceLineageTag: [gold].[ext_fact_trigger_event]

	/// Trigger audit rows fired in the last 24 hours.
	measure 'Triggers Fired (24h)' = ```
			CALCULATE(
			    COUNTROWS(ext_fact_trigger_event),
			    ext_fact_trigger_event[ext_trigger_status] = "trigger-fired",
			    ext_fact_trigger_event[ext_triggered_at] >= NOW() - 1
			)
		```
		formatString: #,0
		lineageTag: 0e6bb9e6-9d53-4056-86ca-701c46395d35

	/// Average elapsed minutes from source onset to trigger evaluation/fire.
	measure 'Mean Time Source->Trigger' = ```
			AVERAGEX(
			    FILTER(
			        ext_fact_trigger_event,
			        NOT ISBLANK(ext_fact_trigger_event[ext_source_onset])
			            && NOT ISBLANK(ext_fact_trigger_event[ext_triggered_at])
			    ),
			    DATEDIFF(
			        ext_fact_trigger_event[ext_source_onset],
			        ext_fact_trigger_event[ext_triggered_at],
			        MINUTE
			    )
			)
		```
		formatString: 0.0
		lineageTag: fdbc9dfd-8d7e-4416-a00f-6cd3126af1b1

	/// Count of non-Actual signals recorded as quarantined in the trigger audit.
	measure 'Signals Quarantined' = ```
			CALCULATE(
			    COUNTROWS(ext_fact_trigger_event),
			    ext_fact_trigger_event[ext_trigger_status] = "quarantined-status"
			)
		```
		formatString: #,0
		lineageTag: baaa080f-c944-4e08-8b83-ce75139e0d4c

	column ext_trigger_event_id
		dataType: string
		lineageTag: 007b6836-b2cd-42de-9f81-1cf4f54eb2dd
