{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "9066815024517090068"
    }
  },
  "parameters": {
    "envSuffix": {
      "type": "string",
      "metadata": {
        "description": "Environment suffix, e.g. sit or prod"
      }
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Existing Container Apps managed environment resource id"
      }
    },
    "eventHubNamespace": {
      "type": "string",
      "metadata": {
        "description": "Existing Event Hub namespace name (evh-ihzhhpf...)"
      }
    },
    "eventHubName": {
      "type": "string",
      "metadata": {
        "description": "Event Hub name for external signals"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "providerRunnerImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/azure-cli:latest",
      "metadata": {
        "description": "Provider-runner container image. Defaults to the azure-cli placeholder; bump to <acr>/signal-runner:<tag> (built by ci-build-signal-runner.yml) to deploy the live ingestion runner."
      }
    },
    "webiqSecretUri": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Full Key Vault secret URI for the Web IQ API key, e.g. https://<kv>.vault.azure.net/secrets/webiq-api-key. Empty = live Web IQ disabled; the runner falls back to the simulator (key presence is the enablement gate)."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Key Vault name holding the Web IQ secret. Set together with webiqSecretUri to grant the runner identity Key Vault Secrets User. Empty = no grant."
      }
    },
    "webiqRegionCantons": {
      "type": "string",
      "defaultValue": "ZH,LU,SZ",
      "metadata": {
        "description": "Comma-separated cantons the Web IQ live queries tag (in-scope hospital cantons: USZ/LUKS/SZB)."
      }
    },
    "signalResidency": {
      "type": "string",
      "defaultValue": "CH",
      "allowedValues": [
        "CH",
        "demo-westus2"
      ],
      "metadata": {
        "description": "DC-EXT-SIGNAL-v1 envelope residency. SIT demo = demo-westus2 (ADR-0013); PROD = CH."
      }
    }
  },
  "variables": {
    "appName": "[format('ca-signal-runner-ihzhhpf-{0}', parameters('envSuffix'))]",
    "identityName": "[format('id-signal-runner-ihzhhpf-{0}', parameters('envSuffix'))]",
    "wireWebIq": "[not(empty(parameters('webiqSecretUri')))]",
    "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6",
    "runnerSecrets": "[if(variables('wireWebIq'), createArray(createObject('name', 'webiq-api-key', 'keyVaultUrl', parameters('webiqSecretUri'), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))), createArray())]",
    "eventHubsDataSenderRoleId": "2b629674-e913-4c01-ae53-ef4638d8f975"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('identityName')]",
      "location": "[parameters('location')]",
      "tags": {
        "env": "[parameters('envSuffix')]",
        "owner": "urruegg",
        "costCenter": "curavias-platform",
        "workload": "external-signals"
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[variables('appName')]",
      "location": "[parameters('location')]",
      "tags": {
        "env": "[parameters('envSuffix')]",
        "owner": "urruegg",
        "costCenter": "curavias-platform",
        "workload": "external-signals"
      },
      "properties": {
        "managedEnvironmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "secrets": "[variables('runnerSecrets')]"
        },
        "template": {
          "containers": [
            {
              "name": "provider-runner",
              "image": "[parameters('providerRunnerImage')]",
              "env": "[if(variables('wireWebIq'), concat(createArray(createObject('name', 'EVENT_HUB_NAMESPACE', 'value', parameters('eventHubNamespace')), createObject('name', 'EVENT_HUB_NAME', 'value', parameters('eventHubName')), createObject('name', 'AZURE_CLIENT_ID', 'value', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId), createObject('name', 'WEBIQ_REGION_CANTONS', 'value', parameters('webiqRegionCantons')), createObject('name', 'SIGNAL_RESIDENCY', 'value', parameters('signalResidency'))), createArray(createObject('name', 'WEBIQ_API_KEY', 'secretRef', 'webiq-api-key'))), createArray(createObject('name', 'EVENT_HUB_NAMESPACE', 'value', parameters('eventHubNamespace')), createObject('name', 'EVENT_HUB_NAME', 'value', parameters('eventHubName')), createObject('name', 'AZURE_CLIENT_ID', 'value', reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').clientId), createObject('name', 'WEBIQ_REGION_CANTONS', 'value', parameters('webiqRegionCantons')), createObject('name', 'SIGNAL_RESIDENCY', 'value', parameters('signalResidency'))))]"
            }
          ],
          "scale": {
            "minReplicas": 0,
            "maxReplicas": 1
          }
        }
      },
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')))]": {}
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.EventHub/namespaces', parameters('eventHubNamespace'))]",
      "name": "[guid(resourceId('Microsoft.EventHub/namespaces', parameters('eventHubNamespace')), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('eventHubsDataSenderRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('eventHubsDataSenderRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ]
    },
    {
      "condition": "[not(empty(parameters('keyVaultName')))]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.KeyVault/vaults', parameters('keyVaultName'))]",
      "name": "[guid(resourceGroup().id, parameters('keyVaultName'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), variables('keyVaultSecretsUserRoleId'))]",
      "properties": {
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('keyVaultSecretsUserRoleId'))]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName'))]"
      ]
    }
  ],
  "outputs": {
    "providerRunnerName": {
      "type": "string",
      "value": "[variables('appName')]"
    },
    "providerRunnerPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('identityName')), '2023-01-31').principalId]"
    },
    "providerRunnerIdentityName": {
      "type": "string",
      "value": "[variables('identityName')]"
    }
  }
}