              "name": "[guid(resourceId('Microsoft.EventHub/namespaces/eventhubs', format('evh-{0}-{1}', parameters('nameSuffix'), variables('globalUniquenessSuffix')), parameters('eventHubName')), parameters('csaAgentMiPrincipalId'), variables('eventHubsDataReceiverRoleId'), 'cg-csa-agent')]",
