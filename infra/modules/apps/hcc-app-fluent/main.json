{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.44.1.10279",
      "templateHash": "13795499997489451137"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "allowedValues": [
        "switzerlandnorth",
        "westus2"
      ],
      "metadata": {
        "description": "Azure region. Region-pinned to the Swiss-region variant path per ADR-0013 demo scope."
      }
    },
    "containerAppName": {
      "type": "string",
      "minLength": 2,
      "maxLength": 32,
      "metadata": {
        "description": "Name for the Container App resource."
      }
    },
    "containerAppEnvironmentId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional resource ID of an existing Container Apps managed environment. When empty, a new consumption-only environment is created inside this module."
      }
    },
    "containerAppEnvironmentName": {
      "type": "string",
      "defaultValue": "[format('cae-{0}', parameters('containerAppName'))]",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Name for the managed environment when one is created by this module. Ignored when containerAppEnvironmentId is provided."
      }
    },
    "logAnalyticsWorkspaceResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional Log Analytics workspace resource ID for the ACA environment. Ignored when containerAppEnvironmentId is provided."
      }
    },
    "containerImage": {
      "type": "string",
      "defaultValue": "mcr.microsoft.com/dotnet/samples:aspnetapp",
      "metadata": {
        "description": "Container image the Fluent app runs. Defaults to a placeholder; the actual hcc-app-fluent image is published from apps/hcc-app-fluent/Dockerfile."
      }
    },
    "containerRegistryLoginServer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional ACR login server (e.g. 'cri75lbu5sj4hza.azurecr.io') the Container App pulls containerImage from. When set together with containerRegistryResourceId, the module wires MI-based image pull (no admin creds, no secrets)."
      }
    },
    "containerRegistryResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional resource ID of the ACR (Microsoft.ContainerRegistry/registries) that hosts containerImage. Required together with containerRegistryLoginServer to enable MI-based pull + AcrPull role assignment."
      }
    },
    "targetPort": {
      "type": "int",
      "defaultValue": 8080,
      "metadata": {
        "description": "Target port the Fluent app container listens on (nginx-unprivileged serves on 8080)."
      }
    },
    "minReplicas": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 0,
      "maxValue": 10,
      "metadata": {
        "description": "Minimum replica count."
      }
    },
    "maxReplicas": {
      "type": "int",
      "defaultValue": 3,
      "minValue": 1,
      "maxValue": 30,
      "metadata": {
        "description": "Maximum replica count."
      }
    },
    "demoScope": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "When true, the deployment is scoped to the Sprint 13 demo path (synthetic data only, ADR-0013 westus2 fallback). Emits a demoScope tag for provenance."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags applied to every resource this module creates."
      }
    }
  },
  "variables": {
    "effectiveTags": "[union(parameters('tags'), createObject('demoScope', if(parameters('demoScope'), 'true', 'false')))]",
    "effectiveEnvironmentId": "[if(not(empty(parameters('containerAppEnvironmentId'))), parameters('containerAppEnvironmentId'), resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName')))]",
    "useAcrMiPull": "[and(not(empty(parameters('containerRegistryLoginServer'))), not(empty(parameters('containerRegistryResourceId'))))]",
    "acrPullRoleId": "7f951dda-4ed3-4680-a7ca-43fe172d538d"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[format('id-{0}', parameters('containerAppName'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('effectiveTags')]"
    },
    {
      "condition": "[empty(parameters('containerAppEnvironmentId'))]",
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppEnvironmentName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('effectiveTags')]",
      "properties": {
        "appLogsConfiguration": "[if(not(empty(parameters('logAnalyticsWorkspaceResourceId'))), createObject('destination', 'log-analytics', 'logAnalyticsConfiguration', createObject('customerId', reference(parameters('logAnalyticsWorkspaceResourceId'), '2023-09-01').customerId, 'sharedKey', listKeys(parameters('logAnalyticsWorkspaceResourceId'), '2023-09-01').primarySharedKey)), createObject('destination', 'azure-monitor'))]",
        "zoneRedundant": false
      }
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('containerAppName')]",
      "location": "[parameters('location')]",
      "tags": "[variables('effectiveTags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[variables('effectiveEnvironmentId')]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": "[parameters('targetPort')]",
            "transport": "auto",
            "allowInsecure": false
          },
          "registries": "[if(variables('useAcrMiPull'), createArray(createObject('server', parameters('containerRegistryLoginServer'), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName'))))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "hcc-app-fluent",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json('0.25')]",
                "memory": "0.5Gi"
              }
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName')))]",
        "[resourceId('Microsoft.App/managedEnvironments', parameters('containerAppEnvironmentName'))]"
      ]
    },
    {
      "condition": "[variables('useAcrMiPull')]",
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.ContainerRegistry/registries', last(split(parameters('containerRegistryResourceId'), '/')))]",
      "name": "[guid(parameters('containerRegistryResourceId'), resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName'))), variables('acrPullRoleId'))]",
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('acrPullRoleId'))]",
        "principalId": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName'))), '2023-01-31').principalId]",
        "principalType": "ServicePrincipal",
        "description": "Sprint 13.1 — hcc-app-fluent MI pulls containerImage from ACR."
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName')))]"
      ]
    }
  ],
  "outputs": {
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Principal ID of the Fluent app User-Assigned Managed Identity."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName'))), '2023-01-31').principalId]"
    },
    "clientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of the Fluent app User-Assigned Managed Identity."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName'))), '2023-01-31').clientId]"
    },
    "identityResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the Fluent app User-Assigned Managed Identity."
      },
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-{0}', parameters('containerAppName')))]"
    },
    "containerAppName": {
      "type": "string",
      "metadata": {
        "description": "Name of the deployed Container App."
      },
      "value": "[parameters('containerAppName')]"
    },
    "containerAppId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the deployed Container App."
      },
      "value": "[resourceId('Microsoft.App/containerApps', parameters('containerAppName'))]"
    },
    "fqdn": {
      "type": "string",
      "metadata": {
        "description": "Public FQDN of the Fluent app ingress."
      },
      "value": "[reference(resourceId('Microsoft.App/containerApps', parameters('containerAppName')), '2024-03-01').configuration.ingress.fqdn]"
    },
    "managedEnvironmentId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the managed environment used by this Container App (created by this module or supplied via containerAppEnvironmentId)."
      },
      "value": "[variables('effectiveEnvironmentId')]"
    },
    "moduleStatus": {
      "type": "string",
      "metadata": {
        "description": "hcc-app-fluent module implementation marker."
      },
      "value": "hcc-app-fluent-implemented"
    }
  }
}