{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.43.8.12551",
      "templateHash": "5484063052217280511"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "westus2",
      "allowedValues": [
        "switzerlandnorth",
        "westus2"
      ],
      "metadata": {
        "description": "Location for the Managed Identities. Region-pinned per ADR-0013."
      }
    },
    "environment": {
      "type": "string",
      "allowedValues": [
        "sit",
        "prod"
      ],
      "metadata": {
        "description": "Environment tag: sit | prod"
      }
    },
    "solutionShortName": {
      "type": "string",
      "defaultValue": "ihzhhpf",
      "metadata": {
        "description": "Solution short name (per AGENTS.md tenant migration note)."
      }
    },
    "eventHubNamespaceName": {
      "type": "string",
      "metadata": {
        "description": "Event Hub namespace name (from data-foundation module output when available)."
      }
    },
    "eventHubName": {
      "type": "string",
      "metadata": {
        "description": "Event Hub name (from data-foundation module output when available). Note: on the sprint-09-v2/t4-semantic-agents branch, T2 data-foundation only creates the namespace, not the hub itself — the hub role assignment will be a no-op until T2 merges."
      }
    },
    "bmCopilotConsumerGroup": {
      "type": "string",
      "defaultValue": "cg-bm-copilot-agent",
      "metadata": {
        "description": "BM-Copilot consumer group name."
      }
    },
    "csaConsumerGroup": {
      "type": "string",
      "defaultValue": "cg-csa-agent",
      "metadata": {
        "description": "CSA consumer group name."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Common resource tags."
      }
    }
  },
  "variables": {
    "bmCopilotIdentityName": "[format('id-bm-copilot-{0}-{1}', parameters('solutionShortName'), parameters('environment'))]",
    "csaIdentityName": "[format('id-csa-{0}-{1}', parameters('solutionShortName'), parameters('environment'))]"
  },
  "resources": [
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('bmCopilotIdentityName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.ManagedIdentity/userAssignedIdentities",
      "apiVersion": "2023-01-31",
      "name": "[variables('csaIdentityName')]",
      "location": "[parameters('location')]",
      "tags": "[parameters('tags')]"
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "[format('foundry-agents-rbac-{0}', parameters('environment'))]",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "bmCopilotPrincipalId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('bmCopilotIdentityName')), '2023-01-31').principalId]"
          },
          "csaPrincipalId": {
            "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('csaIdentityName')), '2023-01-31').principalId]"
          },
          "eventHubNamespaceName": {
            "value": "[parameters('eventHubNamespaceName')]"
          },
          "eventHubName": {
            "value": "[parameters('eventHubName')]"
          },
          "bmCopilotConsumerGroup": {
            "value": "[parameters('bmCopilotConsumerGroup')]"
          },
          "csaConsumerGroup": {
            "value": "[parameters('csaConsumerGroup')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.43.8.12551",
              "templateHash": "788889626278574832"
            }
          },
          "parameters": {
            "bmCopilotPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID (object ID) of the BM-Copilot managed identity."
              }
            },
            "csaPrincipalId": {
              "type": "string",
              "metadata": {
                "description": "Principal ID (object ID) of the CSA managed identity."
              }
            },
            "eventHubNamespaceName": {
              "type": "string",
              "metadata": {
                "description": "Event Hub namespace name (existing)."
              }
            },
            "eventHubName": {
              "type": "string",
              "metadata": {
                "description": "Event Hub name (existing, child of the namespace)."
              }
            },
            "bmCopilotConsumerGroup": {
              "type": "string",
              "metadata": {
                "description": "BM-Copilot consumer group name. Reserved for T2-merge scope narrowing."
              }
            },
            "csaConsumerGroup": {
              "type": "string",
              "metadata": {
                "description": "CSA consumer group name. Reserved for T2-merge scope narrowing."
              }
            }
          },
          "variables": {
            "storageBlobDataReaderRoleId": "2a2b9908-6ea1-4ae2-8e65-a410df84e7d1",
            "eventHubsDataReceiverRoleId": "a638d3c7-ab3a-418d-83e6-5f17a39d4fde"
          },
          "resources": [
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('bmCopilotPrincipalId'), variables('storageBlobDataReaderRoleId'))]",
              "properties": {
                "principalId": "[parameters('bmCopilotPrincipalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataReaderRoleId'))]"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.EventHub/namespaces/eventhubs', parameters('eventHubNamespaceName'), parameters('eventHubName'))]",
              "name": "[guid(resourceId('Microsoft.EventHub/namespaces/eventhubs', parameters('eventHubNamespaceName'), parameters('eventHubName')), parameters('bmCopilotPrincipalId'), variables('eventHubsDataReceiverRoleId'))]",
              "properties": {
                "principalId": "[parameters('bmCopilotPrincipalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('eventHubsDataReceiverRoleId'))]"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "name": "[guid(resourceGroup().id, parameters('csaPrincipalId'), variables('storageBlobDataReaderRoleId'))]",
              "properties": {
                "principalId": "[parameters('csaPrincipalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('storageBlobDataReaderRoleId'))]"
              }
            },
            {
              "type": "Microsoft.Authorization/roleAssignments",
              "apiVersion": "2022-04-01",
              "scope": "[resourceId('Microsoft.EventHub/namespaces/eventhubs', parameters('eventHubNamespaceName'), parameters('eventHubName'))]",
              "name": "[guid(resourceId('Microsoft.EventHub/namespaces/eventhubs', parameters('eventHubNamespaceName'), parameters('eventHubName')), parameters('csaPrincipalId'), variables('eventHubsDataReceiverRoleId'))]",
              "properties": {
                "principalId": "[parameters('csaPrincipalId')]",
                "principalType": "ServicePrincipal",
                "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('eventHubsDataReceiverRoleId'))]"
              }
            }
          ],
          "outputs": {
            "moduleStatus": {
              "type": "string",
              "value": "foundry-hosted-agents-rbac-implemented"
            }
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('bmCopilotIdentityName'))]",
        "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('csaIdentityName'))]"
      ]
    }
  ],
  "outputs": {
    "bmCopilotPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('bmCopilotIdentityName')), '2023-01-31').principalId]"
    },
    "bmCopilotClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('bmCopilotIdentityName')), '2023-01-31').clientId]"
    },
    "bmCopilotIdentityResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('bmCopilotIdentityName'))]"
    },
    "bmCopilotIdentityName": {
      "type": "string",
      "value": "[variables('bmCopilotIdentityName')]"
    },
    "csaPrincipalId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('csaIdentityName')), '2023-01-31').principalId]"
    },
    "csaClientId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('csaIdentityName')), '2023-01-31').clientId]"
    },
    "csaIdentityResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', variables('csaIdentityName'))]"
    },
    "csaIdentityName": {
      "type": "string",
      "value": "[variables('csaIdentityName')]"
    },
    "moduleStatus": {
      "type": "string",
      "value": "foundry-hosted-agents-implemented"
    }
  }
}