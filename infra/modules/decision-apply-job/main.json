{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.45.6.27763",
      "templateHash": "4040045096906531905"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "allowedValues": [
        "switzerlandnorth",
        "westus2"
      ],
      "metadata": {
        "description": "Azure region. Region-pinned to the ADR-0013 demo-scope variant path."
      }
    },
    "nameSuffix": {
      "type": "string",
      "minLength": 3,
      "metadata": {
        "description": "Resource name suffix, e.g. ihzhhpf-sit or ihzhhpf-prod."
      }
    },
    "tags": {
      "type": "object",
      "defaultValue": {},
      "metadata": {
        "description": "Resource tags applied to every resource this module creates."
      }
    },
    "managedEnvironmentId": {
      "type": "string",
      "minLength": 2,
      "metadata": {
        "description": "Resource ID of the agent-host Container Apps managed environment (VNet-integrated per ADR-0029 Option A). The job MUST run here so it reaches the Cosmos private endpoint."
      }
    },
    "containerImage": {
      "type": "string",
      "metadata": {
        "description": "Container image the apply job runs. Reuse the hcc-agent-host image — it bakes in data-platform/decision/ (Sprint 26 WS-C) and the azure-identity/azure-cosmos runtime deps."
      }
    },
    "cosmosEndpoint": {
      "type": "string",
      "metadata": {
        "description": "Cosmos document endpoint the seed writes to (e.g. https://cosmos-csa-ihzhhpf-sit.documents.azure.com:443/). Passed to the container as CSA_COSMOS_ENDPOINT."
      }
    },
    "cosmosDatabase": {
      "type": "string",
      "defaultValue": "csa",
      "metadata": {
        "description": "Cosmos database name that holds the plans/proposed_actions containers."
      }
    },
    "foundryEndpoint": {
      "type": "string",
      "defaultValue": "https://ai-ihzhhpf-sit-eastus2.services.ai.azure.com",
      "metadata": {
        "description": "Foundry project data-plane account endpoint (ADR-0032, eastus2). Passed as FOUNDRY_PROJECT_ENDPOINT."
      }
    },
    "foundryProject": {
      "type": "string",
      "defaultValue": "ai-ihzhhpf-sit-eastus2-project",
      "metadata": {
        "description": "Foundry project name (ADR-0032). Passed as FOUNDRY_PROJECT_NAME."
      }
    },
    "containerRegistryLoginServer": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional ACR login server for MI-based image pull. Set together with containerRegistryResourceId. When empty, the job relies on public/anonymous pull."
      }
    },
    "containerRegistryResourceId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional resource ID of the ACR that hosts containerImage. Required together with containerRegistryLoginServer."
      }
    },
    "replicaTimeoutSeconds": {
      "type": "int",
      "defaultValue": 1800,
      "minValue": 60,
      "maxValue": 3600,
      "metadata": {
        "description": "Replica timeout (seconds) for a single apply execution."
      }
    },
    "demoScope": {
      "type": "bool",
      "defaultValue": false,
      "metadata": {
        "description": "When true, emits a demoScope tag for provenance (ADR-0013)."
      }
    }
  },
  "variables": {
    "effectiveTags": "[union(parameters('tags'), createObject('demoScope', if(parameters('demoScope'), 'true', 'false')))]",
    "useAcrMiPull": "[and(not(empty(parameters('containerRegistryLoginServer'))), not(empty(parameters('containerRegistryResourceId'))))]",
    "planCommand": "cd /app/data-platform/decision && python -m coordination.seed_live --action plan && python -m foundry.register_decision_tier --action plan"
  },
  "resources": [
    {
      "type": "Microsoft.App/jobs",
      "apiVersion": "2024-03-01",
      "name": "[format('caj-decision-apply-{0}', parameters('nameSuffix'))]",
      "location": "[parameters('location')]",
      "tags": "[variables('effectiveTags')]",
      "identity": {
        "type": "UserAssigned",
        "userAssignedIdentities": {
          "[format('{0}', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-ca-agent-host-{0}', parameters('nameSuffix'))))]": {}
        }
      },
      "properties": {
        "environmentId": "[parameters('managedEnvironmentId')]",
        "configuration": {
          "triggerType": "Manual",
          "replicaTimeout": "[parameters('replicaTimeoutSeconds')]",
          "replicaRetryLimit": 0,
          "manualTriggerConfig": {
            "parallelism": 1,
            "replicaCompletionCount": 1
          },
          "registries": "[if(variables('useAcrMiPull'), createArray(createObject('server', parameters('containerRegistryLoginServer'), 'identity', resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-ca-agent-host-{0}', parameters('nameSuffix'))))), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "decision-apply",
              "image": "[parameters('containerImage')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "command": [
                "/bin/sh",
                "-c",
                "[variables('planCommand')]"
              ],
              "env": [
                {
                  "name": "AZURE_CLIENT_ID",
                  "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-ca-agent-host-{0}', parameters('nameSuffix'))), '2023-01-31').clientId]"
                },
                {
                  "name": "CSA_COSMOS_ENDPOINT",
                  "value": "[parameters('cosmosEndpoint')]"
                },
                {
                  "name": "CSA_COSMOS_DATABASE",
                  "value": "[parameters('cosmosDatabase')]"
                },
                {
                  "name": "FOUNDRY_PROJECT_ENDPOINT",
                  "value": "[parameters('foundryEndpoint')]"
                },
                {
                  "name": "FOUNDRY_PROJECT_NAME",
                  "value": "[parameters('foundryProject')]"
                }
              ]
            }
          ]
        }
      }
    }
  ],
  "outputs": {
    "jobName": {
      "type": "string",
      "metadata": {
        "description": "Name of the manual-trigger decision-apply Container Apps Job."
      },
      "value": "[format('caj-decision-apply-{0}', parameters('nameSuffix'))]"
    },
    "jobResourceId": {
      "type": "string",
      "metadata": {
        "description": "Resource ID of the decision-apply job."
      },
      "value": "[resourceId('Microsoft.App/jobs', format('caj-decision-apply-{0}', parameters('nameSuffix')))]"
    },
    "identityClientId": {
      "type": "string",
      "metadata": {
        "description": "Client ID of the reused agent-host MI (for runbook cross-checks)."
      },
      "value": "[reference(resourceId('Microsoft.ManagedIdentity/userAssignedIdentities', format('id-ca-agent-host-{0}', parameters('nameSuffix'))), '2023-01-31').clientId]"
    },
    "moduleStatus": {
      "type": "string",
      "metadata": {
        "description": "Decision-apply job module implementation marker."
      },
      "value": "decision-apply-job-implemented"
    }
  }
}