              "sku": {
                "name": "Standard",
                "tier": "Standard"
              },
              "properties": {
                "publicNetworkAccess": "Enabled",
                "minimumTlsVersion": "1.2"
              }
            }
          ],
          "outputs": {
            "moduleStatus": {
              "type": "string",
              "metadata": {
                "description": "Integration module implementation marker."
              },
              "value": "integration-implemented"
            },
            "serviceBusNamespaceName": {
              "type": "string",
              "metadata": {
                "description": "Service Bus namespace name."
              },
              "value": "[format('sb-{0}', parameters('nameSuffix'))]"
            },
            "serviceBusNamespaceResourceId": {
              "type": "string",
              "metadata": {
                "description": "Service Bus namespace resource ID."
              },
              "value": "[resourceId('Microsoft.ServiceBus/namespaces', format('sb-{0}', parameters('nameSuffix')))]"
            },
            "scaffoldInput": {
              "type": "object",
              "metadata": {
                "description": "Integration module scaffold input echo for validation only."
              },
              "value": {
                "location": "[parameters('location')]",
                "nameSuffix": "[parameters('nameSuffix')]",
                "tagCount": "[length(items(parameters('tags')))]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "keyVaultName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('platform-foundation-{0}', parameters('environmentName'))), '2025-04-01').outputs.keyVaultName.value]"
    },
    "logAnalyticsWorkspaceName": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('platform-foundation-{0}', parameters('environmentName'))), '2025-04-01').outputs.logAnalyticsWorkspaceName.value]"
    },
    "moduleStatuses": {
      "type": "object",
      "value": {
        "identity": "[if(parameters('enableIdentityModule'), reference(resourceId('Microsoft.Resources/deployments', format('identity-{0}', parameters('environmentName'))), '2025-04-01').outputs.moduleStatus.value, 'identity-disabled')]",
        "network": "[if(parameters('enableNetworkModule'), reference(resourceId('Microsoft.Resources/deployments', format('network-{0}', parameters('environmentName'))), '2025-04-01').outputs.moduleStatus.value, 'network-disabled')]",
        "observability": "[if(parameters('enableObservabilityModule'), reference(resourceId('Microsoft.Resources/deployments', format('observability-{0}', parameters('environmentName'))), '2025-04-01').outputs.moduleStatus.value, 'observability-disabled')]",
        "dataPlatform": "[if(parameters('enableDataPlatformModule'), reference(resourceId('Microsoft.Resources/deployments', format('data-platform-{0}', parameters('environmentName'))), '2025-04-01').outputs.moduleStatus.value, 'data-platform-disabled')]",
        "aiPlatform": "[if(parameters('enableAiPlatformModule'), reference(resourceId('Microsoft.Resources/deployments', format('ai-platform-{0}', parameters('environmentName'))), '2025-04-01').outputs.moduleStatus.value, 'ai-platform-disabled')]",
        "integration": "[if(parameters('enableIntegrationModule'), reference(resourceId('Microsoft.Resources/deployments', format('integration-{0}', parameters('environmentName'))), '2025-04-01').outputs.moduleStatus.value, 'integration-disabled')]"
      }
    }
  }
}