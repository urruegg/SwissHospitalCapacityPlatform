#!/usr/bin/env bash
# Pre-commit doc-steward gate for the Swiss Hospital Capacity Platform.
#
# Enforces mechanical guarantees BEFORE a commit is written ("check before
# we save"): encoding integrity (no double-encoded UTF-8 / mojibake), a clean
# markdownlint pass on staged Markdown, and a regenerated app evidence fixture
# whenever its governance-doc inputs change. The matching CI jobs (ci.yml
# mojibake-scan + markdown-lint, evidence-publish self-test) are the enforced
# backstop for everyone; this hook is the fast local mirror.
#
# Enable once per clone:
#     git config core.hooksPath .githooks
#
# Judgment steps (version bump, FR/NFR traceability, status accuracy) are NOT
# mechanical and are covered by the document-authoring skill + knowledge-agent,
# not by this hook.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

py="$(command -v python3 || command -v python || true)"

# 1. Mojibake gate on staged files (mechanical; needs only python + git).
if [ -n "$py" ]; then
  if ! PYTHONUTF8=1 "$py" scripts/lint/check_mojibake.py --staged; then
    echo ""
    echo "pre-commit: mojibake (double-encoded UTF-8) detected in staged files."
    echo "  Repair:  $py scripts/lint/fix_mojibake.py <file>   # then: git add <file>"
    echo "  Or add a 'mojibake-allow' marker to any line that must show a literal example."
    exit 1
  fi
else
  echo "pre-commit: WARNING - python not found; skipping mojibake gate (CI still enforces it)." >&2
fi

# 2. Markdown lint gate on staged .md (auto-fix the safe rules, re-stage, verify).
md_files=()
while IFS= read -r line; do
  [ -n "$line" ] && md_files+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACM -- '*.md')

if [ "${#md_files[@]}" -gt 0 ]; then
  if command -v npx >/dev/null 2>&1; then
    npx --yes markdownlint-cli2 --fix "${md_files[@]}" >/dev/null 2>&1 || true
    git add -- "${md_files[@]}"
    if ! npx --yes markdownlint-cli2 "${md_files[@]}"; then
      echo ""
      echo "pre-commit: markdownlint errors remain in staged docs (see above). Fix and re-stage." >&2
      exit 1
    fi
  else
    echo "pre-commit: WARNING - npx/node not found; skipping markdown lint gate (CI still enforces it)." >&2
  fi
fi

# 3. Evidence fixture gate: the committed app fixture
# (apps/hcc-app-fluent/src/data/evidence/evidence-demo.json) is deterministically
# regenerated from governance docs (ADR/PRD/BOM). When any of those inputs is
# staged, regenerate and re-stage the fixture so it can never drift out of sync
# (the evidence-publish self-test enforces this in CI). Mirrors the markdown
# auto-fix pattern above: regenerate -> re-stage -> verify.
if [ -n "$py" ]; then
  evidence_trigger="$(git diff --cached --name-only --diff-filter=ACM -- \
      'docs/adr/**' 'docs/PRD.md' 'docs/bom.yaml' 'docs/region-availability.yaml' \
      'docs/adr-requirement-map.yaml' 'scripts/evidence/**' \
      'apps/hcc-app-fluent/src/data/evidence/evidence-demo.json' || true)"
  if [ -n "$evidence_trigger" ]; then
    if PYTHONUTF8=1 "$py" -m scripts.evidence.build_app_fixture >/dev/null 2>&1; then
      git add -- apps/hcc-app-fluent/src/data/evidence/evidence-demo.json
      if ! PYTHONUTF8=1 "$py" -m unittest \
          scripts.evidence.tests.test_app_fixture.TestAppFixture.test_committed_fixture_matches_regen \
          >/dev/null 2>&1; then
        echo ""
        echo "pre-commit: evidence fixture is still stale after regeneration." >&2
        echo "  Investigate:  $py -m scripts.evidence.build_app_fixture" >&2
        exit 1
      fi
    else
      echo "pre-commit: WARNING - evidence fixture regen failed (missing deps, e.g. PyYAML); CI still enforces it." >&2
    fi
  fi
fi

echo "pre-commit: doc-steward gates passed (encoding + markdown lint)."