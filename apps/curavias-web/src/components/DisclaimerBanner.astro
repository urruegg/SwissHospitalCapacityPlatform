---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<aside class="cv-disclaimer" role="note" aria-label={c.disclaimer.badge}>
  <div class="cv-wrap cv-disclaimer__inner">
    <span class="cv-disclaimer__badge">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="2" />
        <circle cx="12" cy="8" r="1.4" fill="currentColor" />
        <path d="M12 11 v6" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      {c.disclaimer.badge}
    </span>
    <p>{c.disclaimer.text}</p>
  </div>
</aside>

<style>
  .cv-disclaimer {
    background: var(--cv-warning-150);
    border-block: 1px solid #EAD9A6;
  }
  .cv-disclaimer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding-block: 0.9rem;
  }
  .cv-disclaimer__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #8A6400;
    white-space: nowrap;
  }
  .cv-disclaimer p {
    margin: 0;
    font-size: 0.95rem;
    color: #5F4A12;
  }
</style>
