---
import type { SiteContent } from '../i18n/types';
import BrandMark from './BrandMark.astro';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const c = content;
const year = new Date().getFullYear();
---
<footer class="cv-footer">
  <div class="cv-wrap">
    <div class="cv-footer__top">
      <div class="cv-footer__brand">
        <BrandMark height={30} />
        <p class="cv-footer__tagline">{c.footer.tagline}</p>
      </div>
      <div class="cv-footer__meta">
        <p>{c.footer.origin}</p>
        <p>{c.footer.poweredBy}</p>
        <p><a href="https://curavias.ch">curavias.ch</a></p>
      </div>
    </div>

    <div class="cv-footer__legal" role="note">
      <strong>{c.footer.legalHeading}:</strong> {c.footer.legal}
    </div>

    <div class="cv-footer__bottom">
      <span>© {year} Microsoft Innovation Hub Zürich</span>
      <nav class="cv-footer__links" aria-label="Legal">
        <a href="#impressum">{c.footer.imprint}</a>
        <a href="#datenschutz">{c.footer.privacy}</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .cv-footer {
    background: var(--cv-secondary-40);
    color: #D7E0EA;
    padding-block: 3rem 1.75rem;
  }
  .cv-footer :global(.cv-brandmark__word) { color: #fff; }
  .cv-footer a { color: #A9E6D4; }
  .cv-footer__top {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: 1fr;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cv-footer__tagline {
    margin: 0.75rem 0 0;
    max-width: 42ch;
    color: #C6D3DF;
  }
  .cv-footer__meta p { margin: 0 0 0.35rem; }
  .cv-footer__legal {
    font-size: 0.9rem;
    color: #B7C4D1;
    padding: 1.25rem 0;
  }
  .cv-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    justify-content: space-between;
    align-items: center;
    font-size: 0.85rem;
    color: #9FB0BF;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
  }
  .cv-footer__links { display: inline-flex; gap: 1.25rem; }

  @media (min-width: 760px) {
    .cv-footer__top { grid-template-columns: 1.6fr 1fr; }
  }
</style>
