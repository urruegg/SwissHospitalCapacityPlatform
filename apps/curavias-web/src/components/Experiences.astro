---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<section id="erlebnisse" class="cv-section cv-section--alt">
  <div class="cv-wrap">
    <p class="cv-eyebrow">{c.experiences.eyebrow}</p>
    <h2>{c.experiences.heading}</h2>

    <ul class="cv-exp__grid">
      {c.experiences.items.map((exp, i) => (
        <li class="cv-card cv-exp">
          <span class="cv-exp__num" aria-hidden="true">{i + 1}</span>
          <h3>{exp.title}</h3>
          <p>{exp.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cv-exp__grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: var(--cv-gap);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .cv-exp { position: relative; }
  .cv-exp__num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 12px;
    background: var(--cv-brand-150);
    color: var(--cv-brand-40);
    font-weight: 800;
    font-size: 1.2rem;
    margin-bottom: 0.75rem;
  }
  .cv-exp h3 { margin-bottom: 0.35rem; }
  .cv-exp p { margin: 0; color: var(--cv-text-secondary); }
</style>
