---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<section id="kurzueberblick" class="cv-section cv-section--alt">
  <div class="cv-wrap cv-summary">
    <div>
      <p class="cv-eyebrow">{c.summary.eyebrow}</p>
      <h2>{c.summary.heading}</h2>
      <p class="cv-lead">{c.summary.body}</p>
    </div>
    <blockquote class="cv-summary__quote">{c.summary.question}</blockquote>
  </div>
</section>

<style>
  .cv-summary {
    display: grid;
    gap: 2rem;
    grid-template-columns: 1fr;
    align-items: center;
  }
  .cv-summary__quote {
    margin: 0;
    padding: 1.5rem 1.75rem;
    border-left: 5px solid var(--cv-brand-70);
    background: var(--cv-surface);
    border-radius: var(--cv-radius-sm);
    box-shadow: var(--cv-shadow-sm);
    font-size: var(--cv-fs-lead);
    font-weight: 600;
    color: var(--cv-neutral-20);
  }
  @media (min-width: 880px) {
    .cv-summary { grid-template-columns: 1.4fr 1fr; }
  }
</style>
