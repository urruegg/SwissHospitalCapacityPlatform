---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<section class="cv-hero">
  <div class="cv-wrap cv-hero__inner">
    <p class="cv-eyebrow cv-hero__eyebrow">{c.hero.eyebrow}</p>
    <h1 class="cv-hero__headline">{c.hero.headline}</h1>
    <p class="cv-hero__subhead">{c.hero.subhead}</p>
    <div class="cv-hero__cta">
      <a class="cv-btn cv-btn--primary" href="#kontakt">{c.hero.ctaPrimary}</a>
      <a class="cv-btn cv-btn--ghost" href="#erlebnisse">{c.hero.ctaSecondary}</a>
    </div>
  </div>
</section>

<style>
  .cv-hero {
    background:
      radial-gradient(1200px 480px at 15% -10%, var(--cv-brand-150), transparent 60%),
      radial-gradient(900px 420px at 100% 0%, var(--cv-info-150), transparent 55%),
      var(--cv-surface);
    border-bottom: var(--cv-border);
  }
  .cv-hero__inner {
    padding-block: clamp(3.5rem, 9vw, 7rem);
    max-width: 46rem;
  }
  .cv-hero__headline {
    font-size: var(--cv-fs-h1);
    margin-bottom: 1rem;
  }
  .cv-hero__subhead {
    font-size: var(--cv-fs-lead);
    color: var(--cv-brand-40);
    font-weight: 600;
    max-width: 40ch;
  }
  .cv-hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
</style>
