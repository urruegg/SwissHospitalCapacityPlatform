---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<section class="cv-section cv-kpi" aria-label={c.kpis.heading}>
  <div class="cv-wrap">
    <ul class="cv-kpi__grid">
      {c.kpis.items.map((kpi) => (
        <li class="cv-kpi__tile">
          <span class="cv-kpi__value">{kpi.value}</span>
          <span class="cv-kpi__label">{kpi.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cv-kpi { padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .cv-kpi__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--cv-gap);
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .cv-kpi__tile {
    text-align: center;
    padding: 1.75rem 1rem;
    border: var(--cv-border);
    border-radius: var(--cv-radius);
    background: var(--cv-surface);
    box-shadow: var(--cv-shadow-sm);
  }
  .cv-kpi__value {
    display: block;
    font-size: clamp(1.9rem, 4vw, 2.6rem);
    font-weight: 800;
    color: var(--cv-brand-40);
    letter-spacing: -0.02em;
  }
  .cv-kpi__label {
    display: block;
    margin-top: 0.4rem;
    color: var(--cv-text-secondary);
  }
</style>
