---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<section id="agenten" class="cv-section">
  <div class="cv-wrap">
    <p class="cv-eyebrow">{c.agents.eyebrow}</p>
    <h2>{c.agents.heading}</h2>
    <p class="cv-lead">{c.agents.intro}</p>

    <ul class="cv-agents__grid">
      {c.agents.items.map((agent) => (
        <li class="cv-card cv-agent">
          <div class="cv-agent__head">
            <span class="cv-agent__code">{agent.code}</span>
            <h3 class="cv-agent__name">{agent.name}</h3>
          </div>
          <p class="cv-agent__role">{agent.role}</p>
          <p class="cv-agent__delivers">{agent.delivers}</p>
          <p class="cv-agent__gate">
            <span class="cv-agent__gatelabel">{c.agents.gateLabel}</span>
            {agent.gate}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cv-agents__grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: var(--cv-gap);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .cv-agent { display: flex; flex-direction: column; }
  .cv-agent__head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .cv-agent__code {
    flex: none;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #fff;
    background: linear-gradient(135deg, var(--cv-brand-70), var(--cv-brand-40));
    padding: 0.25rem 0.5rem;
    border-radius: 7px;
  }
  .cv-agent__name { margin: 0; font-size: 1.1rem; }
  .cv-agent__role {
    margin: 0 0 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--cv-text-secondary);
  }
  .cv-agent__delivers { margin: 0 0 1rem; flex: 1; }
  .cv-agent__gate {
    margin: 0;
    font-size: 0.9rem;
    color: var(--cv-neutral-20);
    padding-top: 0.75rem;
    border-top: var(--cv-border);
  }
  .cv-agent__gatelabel {
    display: inline-block;
    margin-right: 0.5rem;
    font-size: 0.68rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--cv-danger-70);
  }
</style>
