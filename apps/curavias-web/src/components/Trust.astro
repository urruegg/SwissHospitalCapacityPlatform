---
import type { SiteContent } from '../i18n/types';
interface Props { content: SiteContent; }
const { content } = Astro.props;
const c = content;
---
<section id="sicherheit" class="cv-section">
  <div class="cv-wrap">
    <p class="cv-eyebrow">{c.trust.eyebrow}</p>
    <h2>{c.trust.heading}</h2>

    <ul class="cv-trust__grid">
      {c.trust.pillars.map((pillar) => (
        <li class="cv-trust__pillar">
          <svg class="cv-trust__icon" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true" focusable="false">
            <path d="M12 2 4 5.2v6c0 4.6 3.2 8.4 8 10.8 4.8-2.4 8-6.2 8-10.8v-6L12 2Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" />
            <path d="M8.4 12.2l2.6 2.6 4.6-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          <h3>{pillar.title}</h3>
          <p>{pillar.body}</p>
        </li>
      ))}
    </ul>

    <p class="cv-trust__key">{c.trust.keyMessage}</p>
  </div>
</section>

<style>
  .cv-trust__grid {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: var(--cv-gap);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  }
  .cv-trust__pillar {
    padding: 1.5rem;
    border: var(--cv-border);
    border-radius: var(--cv-radius);
    background: var(--cv-surface);
    box-shadow: var(--cv-shadow-sm);
  }
  .cv-trust__icon { color: var(--cv-brand-60); margin-bottom: 0.6rem; }
  .cv-trust__pillar h3 { font-size: 1.05rem; margin-bottom: 0.35rem; }
  .cv-trust__pillar p { margin: 0; color: var(--cv-text-secondary); }
  .cv-trust__key {
    margin-top: 1.75rem;
    padding: 1.25rem 1.5rem;
    background: var(--cv-brand-150);
    border-left: 5px solid var(--cv-brand-60);
    border-radius: var(--cv-radius-sm);
    font-weight: 600;
    color: var(--cv-brand-30);
  }
</style>
