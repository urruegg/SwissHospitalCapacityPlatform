---
import type { SiteContent, Locale } from '../i18n/types';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { availableLocales, localeHref, defaultLocale } from '../i18n';
import '../styles/global.css';

interface Props {
  content: SiteContent;
}
const { content } = Astro.props;
const c = content;
const locale: Locale = c.locale;
const siteBase = (Astro.site ?? new URL('https://curavias.ch')).origin;
const alternates = availableLocales();
---
<!doctype html>
<html lang={c.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{c.meta.title}</title>
    <meta name="description" content={c.meta.description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://curavias.ch').href} />

    <!-- hreflang alternates -->
    {alternates.map((l) => (
      <link rel="alternate" hreflang={l === defaultLocale ? 'de-CH' : l} href={`${siteBase}${localeHref(l)}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${siteBase}${localeHref(defaultLocale)}`} />


    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Curavias" />
    <meta property="og:title" content={c.meta.title} />
    <meta property="og:description" content={c.meta.description} />
    <meta property="og:locale" content={c.htmlLang.replace('-', '_')} />
    <meta name="robots" content="index,follow" />

    <link rel="icon" type="image/svg+xml" href="/brand/curavias-icon.svg" />
    <meta name="theme-color" content="#17B890" />
  </head>
  <body>
    <a class="cv-skip" href="#main">{c.nav.skip}</a>
    <Header content={c} locale={locale} />
    <main id="main">
      <slot />
    </main>
    <Footer content={c} />
  </body>
</html>
