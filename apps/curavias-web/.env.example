# Curavias web — build-time environment variables (example).
# Copy to `.env` for local overrides; never commit real values.

# Optional public base URL for the Azure Storage media library
# (container `media` on stmediaihzhhpfprod). When unset, the site uses
# in-repo assets only. Must be a public-read URL; non-PHI, brand-approved
# marketing media only. See docs/runbooks/curavias-web-media-library.md.
PUBLIC_MEDIA_BASE_URL=
