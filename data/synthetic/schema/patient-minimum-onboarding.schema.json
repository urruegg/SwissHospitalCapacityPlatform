{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "patient-minimum-onboarding.schema.json",
  "title": "Patient Minimum-Data Onboarding Dataset (DC-ONB-PATIENT-v1)",
  "description": "Synthesized, non-production SIT dataset for the patient minimum-data onboarding lane. Enforces a minimized, pseudonymous field set with purpose and residency tags (FR-ONB-001, NFR-COMP-011, CH-C01).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId",
    "contractId",
    "contractVersion",
    "classification",
    "residency",
    "purposeTags",
    "records"
  ],
  "properties": {
    "datasetId": { "type": "string", "pattern": "^DS-ONB-PATIENT-[a-z0-9-]+$" },
    "contractId": { "type": "string", "enum": ["DC-ONB-PATIENT-v1"] },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classification": { "type": "string", "enum": ["operational-confidential"] },
    "residency": { "type": "string", "enum": ["CH"] },
    "purposeTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["capacity-planning", "discharge-coordination", "bed-management"]
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "onboardingId",
          "pseudonymId",
          "ageBand",
          "sex",
          "admissionType",
          "careSpecialty",
          "arrivalDate",
          "purposeTag",
          "minimizationReviewed"
        ],
        "properties": {
          "onboardingId": { "type": "string", "pattern": "^ONB-[A-Z]{2,4}-[0-9]{4,}$" },
          "pseudonymId": { "type": "string", "pattern": "^PSN-[0-9a-f]{8}$" },
          "ageBand": { "type": "string", "enum": ["0-17", "18-39", "40-64", "65-79", "80+"] },
          "sex": { "type": "string", "enum": ["female", "male", "other", "unspecified"] },
          "admissionType": { "type": "string", "enum": ["emergency", "elective", "transfer", "observation"] },
          "careSpecialty": { "type": "string", "pattern": "^[a-z][a-z-]+$" },
          "arrivalDate": { "type": "string", "format": "date" },
          "purposeTag": {
            "type": "string",
            "enum": ["capacity-planning", "discharge-coordination", "bed-management"]
          },
          "minimizationReviewed": { "type": "boolean" }
        }
      }
    }
  }
}
