{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "dc-or-schedule-v1.schema.json",
  "title": "OR Schedule Contract (DC-OR-SCHEDULE-v1)",
  "description": "Operating-room slate contract (Sprint 09 draft per AMA HCC/North Star review H-07 / FR-OR-001). Contract only; ingestion in Sprint 10. Follows the dc-demand-encounter-v1 envelope pattern. Extends the reference ontology hcp:ORSlot capacity-unit subtype (see docs/ontology/reference-layer.ttl). ADR-0013 westus2 demo-scope exception applies at the ingestion layer for synthetic data only; PROD PHI paths remain gated on Swiss residency per ADR-0003/0004.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "datasetId", "contractId", "contractVersion",
    "classification", "residency", "purposeTags", "records"
  ],
  "properties": {
    "datasetId":       { "type": "string", "pattern": "^DS-OR-SCHEDULE-[a-z0-9-]+$" },
    "contractId":      { "type": "string", "enum": ["DC-OR-SCHEDULE-v1"] },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "classification":  { "type": "string", "enum": ["operational-confidential"] },
    "residency":       { "type": "string", "enum": ["CH"] },
    "purposeTags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["or-steering", "capacity-planning", "scheduling-optimization"]
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contractId", "orSlotId", "theatreId", "slotStart", "slotEnd",
          "plannedDurationMinutes", "status", "specialtyServiceId",
          "purposeTag", "dataResidencyRegion", "asOfTimestamp"
        ],
        "properties": {
          "contractId":              { "type": "string", "enum": ["DC-OR-SCHEDULE-v1"] },
          "orSlotId":                { "type": "string", "pattern": "^ORS-[A-Z0-9-]+$", "description": "Unique OR slot identifier. Maps to hcp:ORSlot in the reference ontology." },
          "theatreId":               { "type": "string", "pattern": "^ORT-[A-Z0-9-]+$", "description": "Physical operating theatre. Maps to hcp:Room subtype in the reference ontology." },
          "slotStart":               { "type": "string", "format": "date-time" },
          "slotEnd":                 { "type": "string", "format": "date-time" },
          "plannedDurationMinutes":  { "type": "integer", "minimum": 15, "maximum": 720 },
          "status": {
            "type": "string",
            "enum": ["planned", "available", "blocked", "cancelled"],
            "description": "Maps to hcp:CapacityState in the reference ontology (planned/available/blocked; cancelled is a schedule-plane terminal state)."
          },
          "plannedCaseId":           { "type": ["string", "null"], "pattern": "^ORC-[A-Z0-9-]+$", "description": "Planned OR case (nullable if slot is available or blocked without a case)." },
          "encounterId":             { "type": ["string", "null"], "pattern": "^ENC-[0-9]{4}-[0-9]{4,}$", "description": "Optional link back to DC-DEMAND-ENCOUNTER-v1 for the associated patient encounter." },
          "specialtyServiceId":      { "type": "string", "pattern": "^HCS-[A-Z0-9-]+$" },
          "requiredAnaesthesiaType": { "type": ["string", "null"], "enum": ["general", "regional", "local", "sedation", "none", null] },
          "requiredEquipmentIds":    { "type": "array", "items": { "type": "string", "pattern": "^DEV-[A-Z0-9-]+$" } },
          "primarySurgeonRoleId":    { "type": ["string", "null"], "pattern": "^ROLE-[A-Z0-9-]+$", "description": "Pseudonymised role reference, not personal identifier." },
          "blockReason":             { "type": ["string", "null"], "enum": ["maintenance", "cleaning", "equipment-outage", "staffing-shortage", "other", null] },
          "purposeTag":              { "type": "string", "enum": ["or-steering", "capacity-planning", "scheduling-optimization"] },
          "dataResidencyRegion":     { "type": "string", "enum": ["switzerlandnorth", "switzerlandwest"] },
          "asOfTimestamp":           { "type": "string", "format": "date-time" },
          "extensions":              { "type": "object" }
        }
      }
    }
  }
}
