{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swisshospitalcapacity/evidence/bom.schema.json",
  "title": "Evidence — Bill of Materials",
  "description": "One row per BOM item parsed from docs/bom.yaml.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "name", "type", "category", "sourcePath", "sourceCommit"],
    "properties": {
      "id": { "type": "string", "pattern": "^bom-[a-z0-9-]+$" },
      "name": { "type": "string", "minLength": 1 },
      "type": { "type": "string", "minLength": 1 },
      "category": {
        "type": "string",
        "enum": ["data", "ai", "app", "integration", "security", "platform", "governance"]
      },
      "sku": { "type": ["string", "null"] },
      "realisesRequirements": { "type": "array", "items": { "type": "string", "pattern": "^(FR|NFR)-[A-Z-]+-[0-9]{3}$" } },
      "governedByAdrs": { "type": "array", "items": { "type": "string", "pattern": "^ADR-[0-9]{4}$" } },
      "sourcePath": { "type": "string", "minLength": 1 },
      "sourceCommit": { "type": "string", "minLength": 1 }
    }
  }
}
