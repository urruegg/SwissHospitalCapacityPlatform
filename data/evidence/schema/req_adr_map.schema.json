{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://swisshospitalcapacity/evidence/req_adr_map.schema.json",
  "title": "Evidence — requirement/ADR map",
  "description": "Edges between requirements and the ADRs that govern them.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["requirementId", "adrId", "sourcePath", "sourceCommit"],
    "properties": {
      "requirementId": { "type": "string", "pattern": "^(FR|NFR)-[A-Z-]+-[0-9]{3}$" },
      "adrId": { "type": "string", "pattern": "^ADR-[0-9]{4}$" },
      "relationship": { "type": "string", "enum": ["governs", "realises", "blocks"] },
      "note": { "type": "string" },
      "sourcePath": { "type": "string", "minLength": 1 },
      "sourceCommit": { "type": "string", "minLength": 1 }
    }
  }
}
